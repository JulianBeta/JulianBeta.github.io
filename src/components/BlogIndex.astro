---
import Base from '../layouts/Base.astro';
import type { Lang } from '../data/profile';
import { t, localePath } from '../data/i18n';
import { getPosts, postSlug, formatDate } from '../data/blog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const posts = await getPosts(lang);
---

<Base lang={lang} title={t(lang, 'blog.title')} description={t(lang, 'blog.intro')}>
  <section class="section">
    <div class="container narrow">
      <h1>{t(lang, 'blog.title')}</h1>
      <p class="lead">{t(lang, 'blog.intro')}</p>
      {posts.length === 0 ? (
        <p>{t(lang, 'blog.empty')}</p>
      ) : (
        <ul class="post-cards">
          {posts.map((post) => (
            <li class="card">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
              <h2><a href={localePath(lang, `/blog/${postSlug(post)}/`)}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <ul class="chips">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
