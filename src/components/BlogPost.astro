---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import type { Lang } from '../data/profile';
import { t, localePath } from '../data/i18n';
import { formatDate, type Post } from '../data/blog';

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const { Content } = await render(post);
const other: Lang = lang === 'en' ? 'es' : 'en';
const altPath = localePath(other, post.data.translation ? `/blog/${post.data.translation}/` : '/blog/');
---

<Base lang={lang} title={post.data.title} description={post.data.description} altPath={altPath}>
  <article class="section">
    <div class="container narrow prose">
      <p><a href={localePath(lang, '/blog/')}>{t(lang, 'blog.back')}</a></p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        {post.data.tags.length > 0 && <> · {post.data.tags.join(', ')}</>}
      </p>
      <Content />
    </div>
  </article>
</Base>
