---
import '@fontsource-variable/oswald';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { profile, type Lang } from '../data/profile';
import { t, localePath, switchLangPath } from '../data/i18n';
import Logo from '../components/Logo.astro';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this page in the other language, when it can't be derived from the URL. */
  altPath?: string;
}

const { lang, title, description = profile.summary[lang], altPath } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} — ${profile.headline[lang]}`;
const other: Lang = lang === 'en' ? 'es' : 'en';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const otherPath = altPath ?? switchLangPath(path, other);
const altEn = new URL(lang === 'en' ? path : otherPath, Astro.site);
const altEs = new URL(lang === 'es' ? path : otherPath, Astro.site);
const home = localePath(lang, '/');
const nav = [
  ['#about', 'nav.about'],
  ['#experience', 'nav.experience'],
  ['#projects', 'nav.projects'],
  ['#collaborations', 'nav.collab'],
  ['blog/', 'nav.blog'],
  ['#contact', 'nav.contact'],
] as const;
const href = (target: string) => (target.startsWith('#') ? `${home}${target}` : localePath(lang, `/${target}`));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} · Blog`} href={new URL(localePath(lang, '/rss.xml'), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CO'} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JB monogram — Julian Betancourt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#011627" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={home}>
          <Logo class="brand-logo" size="2.1rem" color="var(--bright-snow)" />
          <span class="brand-name">Julian Betancourt</span>
        </a>
        <nav aria-label="Main">
          <ul class="nav-list">
            {nav.map(([target, key]) => <li><a href={href(target)}>{t(lang, key)}</a></li>)}
          </ul>
        </nav>
        <a class="lang-switch" href={otherPath} hreflang={other} lang={other} data-testid="lang-switch">
          {t(lang, 'lang.switch')}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-brand" href={home}>
          <Logo size="2.6rem" color="var(--bright-snow)" />
          <span>
            <strong>{profile.name}</strong>
            <small>© {new Date().getFullYear()}</small>
          </span>
        </a>
        <p class="tested"><span class="check" aria-hidden="true">✓</span> {t(lang, 'footer.tested')}</p>
        <SocialLinks class="footer-links" />
      </div>
    </footer>
  </body>
</html>
