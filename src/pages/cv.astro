---
// Print-optimized CV rendered from the same data as the site.
// `npm run cv` exports it to public/cv/Julian-Betancourt-CV.pdf.
import { profile, experience, skills, certifications, languages, projects } from '../data/profile';
import { formatMonth } from '../data/i18n';

const lang = 'en';
const range = (start: string, end: string | null) =>
  `${formatMonth(start, lang)} – ${end ? formatMonth(end, lang) : 'Present'}`;

// Roles with a single highlight are older ones: shown compactly to keep the CV to two pages.
const mainJobs = experience.filter((j) => j.highlights.en.length > 1);
const earlierJobs = experience.filter((j) => j.highlights.en.length <= 1);
const liveProjects = projects.filter((p) => p.status === 'live' && p.repo);
const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — CV</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      @page { size: Letter; margin: 0.5in 0; }
      @page :first { margin-top: 0; }
      :root {
        --ink: #0b1020;
        --text: #1f2937;
        --muted: #4b5563;
        --rule: #d7dce8;
        --accent: #047857;
        --accent-bright: #34d399;
        --accent-2: #3b5bdb;
        --chip: #eef2ff;
        --font: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      html { background: #e5e7eb; }
      body {
        margin: 0 auto; max-width: 8.5in; background: #fff; color: var(--text);
        font-family: var(--font); font-size: 9.6pt; line-height: 1.45;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      body { padding: 0 0.55in; }
      @media screen { body { padding-bottom: 0.5in; box-shadow: 0 10px 40px #0002; } }
      @media print { html { background: #fff; } }
      a { color: inherit; text-decoration: none; }
      h1, h2, h3 { margin: 0; color: var(--ink); letter-spacing: -0.01em; }

      .cv-header {
        background: var(--ink); color: #e6e9f2; margin: 0 -0.55in 0.22in; padding: 0.42in 0.55in 0.3in;
        display: grid; grid-template-columns: auto 1fr; gap: 0.22in; align-items: center;
      }
      .mark {
        width: 0.62in; height: 0.62in; border-radius: 0.13in; display: grid; place-items: center;
        background: var(--accent-bright); color: #052e1f; font-weight: 800; font-size: 17pt;
      }
      .cv-header h1 { color: #fff; font-size: 23pt; line-height: 1.1; letter-spacing: -0.02em; }
      .headline { margin: 0.04in 0 0.08in; color: var(--accent-bright); font-weight: 600; font-size: 11pt; }
      .contact { display: flex; flex-wrap: wrap; gap: 0.02in 0.16in; margin: 0; padding: 0; list-style: none; font-size: 8.6pt; color: #c3cadb; }
      .contact li::before { content: '▸ '; color: var(--accent-bright); }

      section { margin-bottom: 0.17in; }
      h2 {
        font-size: 10.5pt; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent);
        border-bottom: 1.5px solid var(--rule); padding-bottom: 0.03in; margin-bottom: 0.08in;
        break-after: avoid;
      }
      h2::before { content: '✓ '; color: var(--accent-bright); }
      p { margin: 0; }

      .skills { display: grid; grid-template-columns: 1.15in 1fr; gap: 0.03in 0.12in; margin: 0; }
      .skills dt { font-weight: 700; color: var(--ink); }
      .skills dd { margin: 0; color: var(--muted); }

      .job { margin-bottom: 0.13in; break-inside: avoid; }
      .job-head { display: flex; justify-content: space-between; gap: 0.2in; align-items: baseline; }
      .job h3 { font-size: 10.6pt; }
      .company { color: var(--accent); }
      .dates { white-space: nowrap; color: var(--muted); font-size: 8.8pt; font-variant-numeric: tabular-nums; }
      .place { color: var(--muted); font-size: 8.8pt; margin: 0.01in 0 0.04in; }
      .job ul { margin: 0; padding-left: 0.17in; }
      .job li { margin-bottom: 0.025in; }
      .job li::marker { color: var(--accent); }
      .chips { display: flex; flex-wrap: wrap; gap: 0.04in; margin: 0.05in 0 0; padding: 0; list-style: none; }
      .chips li { font-family: var(--mono); font-size: 7.4pt; padding: 0.01in 0.06in; border-radius: 0.04in; background: var(--chip); color: var(--accent-2); }

      .earlier { list-style: none; margin: 0; padding: 0; }
      .earlier li { display: grid; grid-template-columns: 1fr auto; gap: 0 0.2in; margin-bottom: 0.07in; break-inside: avoid; }
      .earlier .what { color: var(--muted); grid-column: 1 / -1; }

      .two-col { display: grid; grid-template-columns: 1.35fr 1fr; gap: 0.3in; break-inside: avoid; }
      .list { list-style: none; margin: 0; padding: 0; }
      .list li { margin-bottom: 0.05in; }
      .list strong { color: var(--ink); }
      .list span { color: var(--muted); }
      .projects li { margin-bottom: 0.06in; }
      .projects a { color: var(--accent-2); font-family: var(--mono); font-size: 8.2pt; }
    </style>
  </head>
  <body>
    <header class="cv-header">
      <div class="mark" aria-hidden="true">{profile.initials}</div>
      <div>
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline.en}</p>
        <ul class="contact">
          <li>{profile.location.en}</li>
          <li><a href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a></li>
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.linkedin}>{strip(profile.linkedin)}</a></li>
          <li><a href={profile.github}>{strip(profile.github)}</a></li>
          <li><a href={profile.website}>{strip(profile.website)}</a></li>
        </ul>
      </div>
    </header>

    <main>
      <section>
        <h2>Profile</h2>
        <p>{profile.summary.en}</p>
      </section>

      <section>
        <h2>Core skills</h2>
        <dl class="skills">
          {skills.map((g) => (
            <>
              <dt>{g.group.en}</dt>
              <dd>{g.items.join(' · ')}</dd>
            </>
          ))}
        </dl>
      </section>

      <section>
        <h2>Experience</h2>
        {mainJobs.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3>{job.role.en} · <span class="company">{job.company}</span></h3>
              <span class="dates">{range(job.start, job.end)}</span>
            </div>
            <p class="place">{job.place.en}</p>
            <ul>{job.highlights.en.map((h) => <li>{h}</li>)}</ul>
            <ul class="chips" aria-label="Stack">{job.stack.map((s) => <li>{s}</li>)}</ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Earlier experience</h2>
        <ul class="earlier">
          {earlierJobs.map((job) => (
            <li>
              <strong>{job.role.en} · <span class="company">{job.company}</span></strong>
              <span class="dates">{range(job.start, job.end)}</span>
              <span class="what">{job.highlights.en[0]}</span>
            </li>
          ))}
        </ul>
      </section>

      <div class="two-col">
        <section>
          <h2>Certifications &amp; training</h2>
          <ul class="list">
            {certifications.map((c) => <li><strong>{c.name}</strong> <span>· {c.issuer}</span></li>)}
          </ul>
        </section>
        <section>
          <h2>Languages</h2>
          <ul class="list">
            {languages.map((l) => <li><strong>{l.name.en}</strong> <span>· {l.level.en}</span></li>)}
          </ul>
        </section>
      </div>

      <section>
        <h2>Selected projects</h2>
        <ul class="list projects">
          {liveProjects.map((p) => (
            <li><strong>{p.name}</strong> <span>— {p.description.en.replace(/^This website\.\s*/, '')}</span><br /><a href={p.repo}>{strip(p.repo!)}</a></li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
